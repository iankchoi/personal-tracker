# Environment for `npm run test` (loaded by tests/setup.ts via dotenv).
# Copy this file to `.env.test` and fill in real values — `.env.test` is
# gitignored and never committed.

# Postgres instance the test suite runs against. Point this at a disposable
# test database, separate from the dev `DATABASE_URL` in `.env` — the test
# suite reads/writes this database directly and migrations are applied to it
# via `npm run db:migrate -- --env test` (which reads `DATABASE_URL_TEST`
# from `.env`, not from this file).
DATABASE_URL=postgresql://user@localhost:5432/personal_tracker_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
AUTH_SECRET=
