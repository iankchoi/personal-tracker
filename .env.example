# Local/test Postgres instance used by the app.
DATABASE_URL=postgresql://user@localhost:5432/personal_tracker_dev

# Postgres instance used only by `db:migrate -- --env test` (db/migrate.ts),
# to apply migrations to the disposable database the test suite runs
# against. The test suite itself does not read this var directly — it reads
# `DATABASE_URL` from `.env.test` (see `.env.test.example`).
DATABASE_URL_TEST=postgresql://user@localhost:5432/personal_tracker_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Google OAuth client credentials (console.cloud.google.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
